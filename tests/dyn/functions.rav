# functions, closures, contracts, errors
fn add(a, b = 10, c = a + b) { a + b + c }
print(add(1), add(1, 2), add(1, 2, 3), add(1, c: 5), add(b: 1, a: 2))
fn make_counter(start) {
    let n = start
    return || { n += 1; n }
}
let c1 = make_counter(10)
let c2 = make_counter(0)
print(c1(), c1(), c2(), c1())
fn compose(f, g) { |x| f(g(x)) }
let inc = |x| x + 1
let dbl = |x| x * 2
print(compose(inc, dbl)(5), compose(dbl, inc)(5), [1, 2, 3].map(compose(inc, inc)))
fn fact(n) { if n <= 1 { 1 } else { n * fact(n - 1) } }
fn fib(n) { if n < 2 { return n }; fib(n - 1) + fib(n - 2) }
print(fact(20), fib(22), map(fact, 0..6))
fn typed(x: int, y: float = 1.5, name: str? = nil) -> float { x * y }
print(typed(2), typed(2, 2.0, "n"))
fn divide(a, b) -> float
    require b != 0
    ensure result' * b == a
{ a / b }
print(divide(6.0, 3.0))
fn bump(x)
    ensure x' == x + 1
{ x += 1; x }
print(bump(4))
fn bad(x) ensure result' > x { x }
let errors = []
fn attempt(f) { try { f(); errors.push("no error") } catch e { errors.push(e) } }
attempt(|| divide(1.0, 0))
attempt(|| bad(3))
attempt(|| typed("s"))
attempt(|| typed(1, 2))
attempt(|| add())
attempt(|| add(1, 2, 3, 4))
attempt(|| add(1, zz: 2))
attempt(|| add(1, a: 2))
attempt(|| 1 / 0)
attempt(|| [1, 2][5])
let dd = {"a": 1}
attempt(|| dd["b"])
attempt(|| undefined_thing)
attempt(|| nil.foo)
attempt(|| "abc".nope())
attempt(|| 9223372036854775807 + 1)
attempt(|| error("custom " + str(42)))
attempt(|| { assert 1 == 2, "math broke" })
attempt(|| int("zz"))
attempt(|| [3, "a"].sorted())
attempt(|| 1[m] + 1[s])
attempt(|| nil())
attempt(|| { let k = 1; k.x = 2 })
attempt(|| { unknown = 3 })
attempt(|| match 5 { 1 => 0 })
attempt(|| { let a, b = [1, 2, 3] })
attempt(|| assert_eq!(1, 2))
for e in errors { print(e) }
const LIMIT = 3
try { LIMIT = 4 } catch e { print(e) }
fn deep(n) { deep(n + 1) }
try { deep(0) } catch e { print("runaway recursion stopped") }
fn early(xs) { for x in xs { if x > 2 { return x } }; -1 }
print(early([1, 2, 3, 4]), early([]))
fn outer() { fn inner(z) { z * 3 }; inner(2) + later() }
fn later() { 100 }
print(outer())
let fs = []
for i in 0..3 { fs.push(|| i * i) }
print(fs.map(|f| f()), fs[1].call())
fn va(a, b) { [a, b] }
print(va(b: 1, a: 2), (|x, y| x + y)(1, 2))
try { try { error("inner") } catch e { error("outer:" + e) } } catch e2 { print(e2) }
fn nested_try() { try { return "from try" } catch e { return "from catch" } }
print(nested_try())
