# Microchip MCP3008 8-channel, 10-bit ADC over SPI (mode 0, up to 3.6 MHz at 5 V).
#
#   from "std/drivers/mcp3008" import Mcp3008
#   let adc = Mcp3008(SPI::new(0, 0), 3.3[V])
#   print(adc.read_volts(0))

from "std/driver" import Adc

struct Mcp3008 impl Adc {
    spi: SPI
    vref: [V] = 3.3[V]
    invariant self.vref > 0[V]

    # With CH0 strapped to ground or VREF a reading is in range, but the part has no ID
    # register; probe() checks that a conversion returns a 10-bit value with the null bit low.
    fn probe(self) -> bool {
        let r = self.spi.transfer([1, 0x80, 0])
        (r[1] & 0x04) == 0
    }

    fn init(self) {
        self.spi.set_mode(0)
        self.spi.set_speed(1000000)
    }

    # Single-ended conversion: start bit, SGL=1 + channel, then clock out 10 bits.
    fn read_raw(self, channel: int) -> int
        require channel >= 0 and channel <= 7
        ensure result' >= 0 and result' <= 1023
    {
        let r = self.spi.transfer([1, (8 + channel) << 4, 0])
        ((r[1] & 3) << 8) | r[2]
    }

    fn read_volts(self, channel: int) -> [V]
        require channel >= 0 and channel <= 7
    {
        self.vref * float(self.read_raw(channel)) / 1023.0
    }
}
