# std/world — a deterministic 2-D physics world for mobile robots.
#
#   import "std/world"
#   let w = world.World(dt: 10[ms], seed: 1)
#   w.wall(0, 2, 4, 2)                         # metres
#   let r = w.rover(x: 1, y: 1)
#   r.drive(0.5, 0.5)                          # wheel commands in -1..1
#   w.step()                                   # advances physics and the virtual clock
#   r.range(0[deg])                            # rangefinder ray → [m]
#
# Fixed-step and seeded: the same program gives the same trajectory on every machine, so
# runs can be compared byte for byte in tests. Pair it with std/emu to put emulated chips
# between this physics and your real driver code.

const G = 9.80665

# Seeded noise source (xorshift), independent of the global random().
struct Noise {
    state: int = 88172645463325252
    fn uniform(self) {
        let x = self.state
        x = x ^ ((x << 13) & 0x7FFFFFFFFFFFFFFF)
        x = x ^ (x >> 7)
        x = x ^ ((x << 17) & 0x7FFFFFFFFFFFFFFF)
        self.state = x
        (x % 1000000007) / 1000000007.0
    }
    # Normal distribution (Box–Muller), standard deviation `sigma`.
    fn gauss(self, sigma = 1.0) {
        let u = max(self.uniform(), 0.000000001)
        sigma * sqrt(-2.0 * log(u)) * cos(TAU * self.uniform())
    }
}

struct Rover {
    world
    x: float = 0.0              # m
    y: float = 0.0              # m
    heading: float = 0.0        # rad, counter-clockwise from +x
    radius: float = 0.12        # m, body radius used for collisions
    wheel_base: float = 0.2     # m
    max_speed: float = 1.0      # m/s at command 1.0
    tau: float = 0.15           # s, motor/drivetrain time constant
    cmd_l: float = 0.0
    cmd_r: float = 0.0
    vl: float = 0.0             # m/s wheel speeds
    vr: float = 0.0
    v: float = 0.0              # m/s body speed
    w: float = 0.0              # rad/s yaw rate
    accel: float = 0.0          # m/s^2 along the body x axis
    odo_l: float = 0.0          # m travelled by each wheel
    odo_r: float = 0.0
    battery: float = 1.0        # 0..1
    drain: float = 0.0005       # fraction per second at full power
    collided: bool = false
    bumps: int = 0

    # Wheel commands in -1..1 (clamped). A dead battery ignores them.
    fn drive(self, left, right) {
        self.cmd_l = clamp(float(left), -1.0, 1.0)
        self.cmd_r = clamp(float(right), -1.0, 1.0)
    }
    fn stop(self) { self.cmd_l = 0.0; self.cmd_r = 0.0 }

    fn _step(self, dt) {
        let live = if self.battery > 0.0 { 1.0 } else { 0.0 }
        let k = dt / (self.tau + dt)
        self.vl = self.vl + (self.cmd_l * self.max_speed * live - self.vl) * k
        self.vr = self.vr + (self.cmd_r * self.max_speed * live - self.vr) * k
        let v = (self.vl + self.vr) / 2.0
        self.w = (self.vr - self.vl) / self.wheel_base
        self.accel = (v - self.v) / dt
        self.v = v
        self.heading = self.heading + self.w * dt
        let nx = self.x + v * cos(self.heading) * dt
        let ny = self.y + v * sin(self.heading) * dt
        if self.world._blocked(nx, ny, self.radius) {
            if not self.collided { self.bumps += 1 }
            self.collided = true
            self.vl = 0.0; self.vr = 0.0; self.v = 0.0
        } else {
            self.collided = false
            self.x = nx; self.y = ny
            self.odo_l = self.odo_l + self.vl * dt
            self.odo_r = self.odo_r + self.vr * dt
        }
        self.battery = max(0.0, self.battery - self.drain * (abs(self.cmd_l) + abs(self.cmd_r)) / 2.0 * dt)
    }

    # Distance to the nearest wall or obstacle along a ray at `angle` from the heading.
    fn range(self, angle = 0[rad], limit = 4[m], sigma = 0[m]) -> [m] {
        let a = self.heading + angle.in("rad")
        let d = self.world._cast(self.x, self.y, cos(a), sin(a), limit.in("m"))
        if sigma.in("m") > 0.0 { d = clamp(d + self.world.noise.gauss(sigma.in("m")), 0.0, limit.in("m")) }
        d * 1[m]
    }

    fn position(self) { [self.x * 1[m], self.y * 1[m]] }
    fn speed(self) -> [m/s] { self.v * 1[m/s] }
    fn yaw_rate(self) -> [rad/s] { self.w * 1[rad/s] }
    fn yaw(self) -> [rad] { self.heading * 1[rad] }
    # What a body-mounted IMU would feel: [ax, ay, az] in m/s^2 and gyro z in rad/s.
    fn imu(self, sigma = 0.0) {
        let n = self.world.noise
        let e = |s| if s > 0.0 { n.gauss(s) } else { 0.0 }
        {ax: (self.accel + e(sigma)) * 1[m/s^2], ay: (self.v * self.w + e(sigma)) * 1[m/s^2],
         az: (G + e(sigma)) * 1[m/s^2], gz: (self.w + e(sigma / 10.0)) * 1[rad/s]}
    }
    fn distance_to(self, px, py) -> [m] { hypot(px - self.x, py - self.y) * 1[m] }
}

struct World {
    dt = 10[ms]
    seed: int = 1
    walls = []                  # [x1, y1, x2, y2] in metres
    discs = []                  # [x, y, r]
    robots = []
    time: float = 0.0           # s
    steps: int = 0
    noise = nil
    advance_clock: bool = true

    fn init(self) { self.noise = Noise(state: 88172645463325252 + self.seed * 7919) }

    fn wall(self, x1, y1, x2, y2) { self.walls.push([float(x1), float(y1), float(x2), float(y2)]); self }
    # A rectangular arena with its lower-left corner at the origin.
    fn arena(self, width, height) {
        self.wall(0, 0, width, 0); self.wall(width, 0, width, height)
        self.wall(width, height, 0, height); self.wall(0, height, 0, 0)
        self
    }
    fn disc(self, x, y, r) { self.discs.push([float(x), float(y), float(r)]); self }

    fn rover(self, x = 0.0, y = 0.0, heading = 0[rad], max_speed = 1[m/s], wheel_base = 0.2[m], radius = 0.12[m]) {
        let r = Rover(world: self, x: float(x), y: float(y), heading: heading.in("rad"),
                      max_speed: max_speed.in("m/s"), wheel_base: wheel_base.in("m"), radius: radius.in("m"))
        self.robots.push(r)
        r
    }

    # Advances physics by n fixed steps; the virtual clock follows unless advance_clock is false.
    fn step(self, n = 1) {
        let dt = self.dt.in("s")
        for i in 0..n {
            for r in self.robots { r._step(dt) }
            self.time = self.time + dt
            self.steps += 1
            if self.advance_clock { sleep(dt) }
        }
    }

    fn _seg_dist(self, px, py, s) {
        let dx = s[2] - s[0]
        let dy = s[3] - s[1]
        let len2 = dx * dx + dy * dy
        let t = if len2 == 0.0 { 0.0 } else { clamp(((px - s[0]) * dx + (py - s[1]) * dy) / len2, 0.0, 1.0) }
        hypot(px - (s[0] + t * dx), py - (s[1] + t * dy))
    }

    fn _blocked(self, x, y, radius) {
        for s in self.walls { if self._seg_dist(x, y, s) < radius { return true } }
        for d in self.discs { if hypot(x - d[0], y - d[1]) < radius + d[2] { return true } }
        false
    }

    # Ray from (ox, oy) along the unit vector (dx, dy): distance to the first hit, or `limit`.
    fn _cast(self, ox, oy, dx, dy, limit) {
        let best = limit
        for s in self.walls {
            let ex = s[2] - s[0]
            let ey = s[3] - s[1]
            let den = dx * ey - dy * ex
            if abs(den) < 0.000000000001 { continue }
            let t = ((s[0] - ox) * ey - (s[1] - oy) * ex) / den
            let u = ((s[0] - ox) * dy - (s[1] - oy) * dx) / den
            if t >= 0.0 and u >= 0.0 and u <= 1.0 and t < best { best = t }
        }
        for d in self.discs {
            let fx = ox - d[0]
            let fy = oy - d[1]
            let b = fx * dx + fy * dy
            let c = fx * fx + fy * fy - d[2] * d[2]
            let disc = b * b - c
            if disc < 0.0 { continue }
            let t = -b - sqrt(disc)
            if t >= 0.0 and t < best { best = t }
        }
        best
    }
}
