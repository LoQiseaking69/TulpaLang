# A state machine driven by the phone's motion.
# Shake the phone: Idle → Alarm (buzz + beep). Hold it still for 2 s: Alarm → Cooldown → Idle.

let motion = signal(0[m/s^2])

machine Guard {
    state Idle {
        enter { print("idle — shake me") }
        on shake(level) if level > 12[m/s^2] => Alarm
    }
    state Alarm {
        enter { print("ALARM"); phone::vibrate([200[ms], 100[ms], 200[ms]]); phone::beep(1200[Hz], 200[ms]) }
        on calm => Cooldown
    }
    state Cooldown {
        enter { print("cooling down") }
        on shake(level) if level > 12[m/s^2] => Alarm
        on calm => Idle
    }
}

let g = Guard()

when motion.get() > 12[m/s^2] { g.shake(motion.get()) }
when motion.get() < 1.5[m/s^2] for 2[s] { g.calm() }

every!(50[ms], 1200, {
    motion.set(phone::shake())
    tlm::plot("shake", phone::shake().in("m/s^2"))
    phone::gauge("state", if g.is("Alarm") { 2 } else if g.is("Cooldown") { 1 } else { 0 }, 0, 2)
})
print("history:", g.history)
